<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>mini Whatsapp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h3>Welcome to mini Whatsapp</h3>
    <form method="GET" action="/chats/new">
        <button class="btn">Add New Chat</button>
    </form>
    <% for (let chat of chats) { %>
        <div class="chat">
            <p>From :<%= chat.from %>:</p>
            <div class ="msg">
                <p><%= chat.msg %></p>
                <form method="GET" action="/chats/<%= chat.id %>/edit">
                <button class="btn">Edit</button>
                </form>
                <br/>
                <form method="POST" action="/chats/<%= chat.id %>/?_method=DELETE">
                <button class="btn">Delete</button>
                </form>
            </div>
             <p>Received by <%= chat.to %></p>
        <hr/>
           <p>Time: <%= chat.created_at.toString().split(" ")[4] %></p>
           <p>Date : <%= chat.created_at.toString().split(" ").slice(0,4).join(" ")%></p>

        </div>
        <br/><br/>
    <% } %>
        
</body>
</html>